# PostgreSQL (service: db)
POSTGRES_USER=evm_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=evm_db

# Connection string for migrate (yoyo) and backend (psycopg ConnectionPool).
# Use postgresql:// (libpq/psycopg format), NOT postgresql+psycopg:// — backend reads
# DATABASE_URL directly via psycopg; yoyo 9.0 also accepts postgresql://.
DATABASE_URL=postgresql://evm_user:changeme@db:5432/evm_db

# Backend CORS — must include the browser origin of the frontend
CORS_ORIGINS=http://localhost:8080

# Frontend build-arg — API base URL as seen from the host browser (not Docker internal hostname)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend log level
LOG_LEVEL=INFO
